# ==============================
# 生产环境配置 (.env.production)
# ==============================

# 环境标识
VITE_ENV = 'production'

# 应用名称
VITE_GLOB_APP_TITLE = 华新计量

# 网站根目录（与老系统路由 base 一致：prod 为 /mes）
VITE_PUBLIC_PATH = /mes/

# 生产环境禁止开启 Mock（开启会将 Mock 数据打包进产物，暴露接口结构）
VITE_USE_MOCK = false

# Hash 路由模式
VITE_HASH_ROUTE = false

# 构建输出目录
VITE_OUTPUT_DIR = 'dist'

# ========== 应用运行模式 ==========
# standalone = 独立运行（使用自身登录流程）
# integrated = 作为子应用集成到 mbase（使用 mbase 登录）
VITE_APP_MODE = standalone

# API 接口地址
# 测试环境（172.x 网段）— 当前启用
VITE_GLOB_API_URL = http://localhost:10010
# 生产环境（164.x 网段）— 上线后取消注释并注释掉上方测试地址
# VITE_GLOB_API_URL = http://164.28.99.172:9000

# 接口前缀
VITE_GLOB_API_URL_PREFIX = /api

# 移动端应用 ID
VITE_GLOB_APP_ID = wl-app-mes

# 图片上传地址
# 测试环境
VITE_GLOB_UPLOAD_URL = http://localhost:10010/upload
# 生产环境
# VITE_GLOB_UPLOAD_URL = http://164.28.99.172:9000/upload

# 图片前缀地址
VITE_GLOB_IMG_URL_PREFIX =

# 地磅实时重量 WebSocket（校磅「取值」）
VITE_SCALE_WS_URL = ws://172.18.191.135:8080/ws/scale
