# ==============================
# 集成模式配置 (.env.integrated)
# 作为子应用集成到 mbase 时使用
# 构建命令：pnpm build:integrated
# ==============================

# 环境标识
VITE_ENV = 'production'

# 应用名称
VITE_GLOB_APP_TITLE = CHENY

# 网站根目录（集成到 mbase 时的子路径）
VITE_PUBLIC_PATH = /mbase/robot-h5/

# 集成模式关闭 Mock
VITE_USE_MOCK = false

# Hash 路由模式
VITE_HASH_ROUTE = false

# 构建输出目录
VITE_OUTPUT_DIR = 'dist'

# ========== 应用运行模式 ==========
# integrated = 作为子应用集成到 mbase（使用 mbase 登录）
VITE_APP_MODE = integrated

# ========== mbase 集成配置 ==========
# 集成模式下 mbase 通过 URL query 透传认证参数（buildAppUrl 生成）：
#   ?portal_token=xxx&from=portal&user_id=xxx&companyId=xxx
# 子应用同步读取（参数名固定 portal_token），无需额外配置传递方式。

# API 接口地址（集成模式下与 mbase 共用网关，按实际环境替换域名）
VITE_GLOB_API_URL = https://ytiop-prd.walsin.com.cn

# 接口前缀（按环境：/sit-api /uat-api /pre-api /prd-api）
VITE_GLOB_API_URL_PREFIX = /prd-api

# 移动端应用 ID
VITE_GLOB_APP_ID = robot-h5

# 图片上传地址
VITE_GLOB_UPLOAD_URL = https://ytiop-prd.walsin.com.cn/prd-api/upload

# 图片前缀地址
VITE_GLOB_IMG_URL_PREFIX =
