# ==============================
# 集成模式配置 (.env.integrated)
# 作为子应用集成到 mbase 时使用
# 构建命令：pnpm build:integrated
# ==============================

# 环境标识
VITE_ENV = 'production'

# 应用名称
VITE_GLOB_APP_TITLE = CHENY

# 网站根目录（集成到 mbase 时的子路径）
VITE_PUBLIC_PATH = /mbase/robot-h5/

# 集成模式关闭 Mock
VITE_USE_MOCK = false

# Hash 路由模式
VITE_HASH_ROUTE = false

# 构建输出目录
VITE_OUTPUT_DIR = 'dist'

# ========== 应用运行模式 ==========
# integrated = 作为子应用集成到 mbase（使用 mbase 登录）
VITE_APP_MODE = integrated

# ========== mbase 集成配置 ==========
# mbase 宿主应用的 origin（用于 postMessage 通信校验）
VITE_MBASE_ORIGIN = http://your-mbase-host.com
# mbase Token 传递方式：query | postMessage | storage
VITE_MBASE_TOKEN_METHOD = query

# API 接口地址（集成模式下通常与 mbase 共用网关）
VITE_GLOB_API_URL = http://172.28.99.172:9000

# 接口前缀
VITE_GLOB_API_URL_PREFIX = /api

# 移动端应用 ID
VITE_GLOB_APP_ID = robot-h5

# 图片上传地址
VITE_GLOB_UPLOAD_URL = http://172.28.99.172:9000/upload

# 图片前缀地址
VITE_GLOB_IMG_URL_PREFIX =
