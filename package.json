{
  "name": "robot-h5",
  "version": "1.8.0",
  "description": "Vue 3 + Vite 7 + TypeScript 企业级移动端 H5 应用模板",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": {
    "name": "CHENY",
    "email": "cheny@agile-team.cn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/Robot_H5.git"
  },
  "keywords": [
    "vue3",
    "vite7",
    "h5",
    "mobile",
    "typescript",
    "enterprise"
  ],
  "scripts": {
    "setup": "node scripts/setup-project.mjs",
    "template:validate": "node scripts/validate-template.mjs && node scripts/verify-build-environment.mjs && node scripts/verify-mobile-compat.mjs",
    "test:compat": "node scripts/verify-mobile-compat.mjs",
    "test:build-env": "node scripts/verify-build-environment.mjs",
    "prepare": "husky",
    "dev": "vite --mode development",
    "dev:prod": "vite --mode production",
    "dev:integrated": "vite --mode sit",
    "build": "node scripts/build.mjs",
    "build:h5": "node scripts/build.mjs",
    "build:sit": "node scripts/build.mjs --env sit",
    "build:pre": "node scripts/build.mjs --env pre",
    "build:test": "node scripts/build.mjs --env sit --legacy build:test",
    "build:uat": "node scripts/build.mjs --env uat --legacy build:uat",
    "build:prod": "node scripts/build.mjs --env production --legacy build:prod",
    "build:integrated": "node scripts/build.mjs --env production --legacy build:integrated",
    "build:vercel": "node scripts/build.mjs --env vercel --legacy build:vercel",
    "preview": "pnpm run build && vite preview --port 5050",
    "preview:dist": "vite preview",
    "clean": "rimraf node_modules && rimraf .eslintcache && rimraf dist",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "cz": "git-cz",
    "deps:check": "pnpm outdated",
    "deps:update": "pnpm update --interactive --latest",
    "preinstall": "npx only-allow pnpm",
    "release": "echo 'Use release-please PR workflow instead'",
    "lint:check": "eslint .",
    "test:e2e": "playwright test",
    "test:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "@iconify/vue": "5.0.3",
    "@miracle-web/utils": "0.0.6",
    "@robot-h5/core": "^1.2.0",
    "@unocss/reset": "66.10.5",
    "@vant/touch-emulator": "1.5.0",
    "@vueuse/core": "15.0.0",
    "disable-devtool": "0.3.9",
    "echarts": "6.1.0",
    "mitt": "3.0.1",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "pinia-plugin-persistedstate": "4.7.1",
    "vant": "4.10.2",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@iconify-json/ic": "1.2.4",
    "@iconify-json/ph": "1.2.2",
    "@playwright/test": "1.64.0",
    "@robot-admin/git-standards": "1.0.5",
    "@types/mockjs": "1.0.10",
    "@types/node": "24.19.2",
    "@types/nprogress": "0.2.3",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@unocss/preset-icons": "66.10.5",
    "@unocss/preset-rem-to-px": "66.10.5",
    "@unocss/transformer-directives": "66.10.5",
    "@unocss/transformer-variant-group": "66.10.5",
    "@vant/auto-import-resolver": "1.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vue/eslint-config-typescript": "14.9.0",
    "autoprefixer": "10.6.1",
    "commitizen": "4.3.2",
    "cz-customizable": "7.5.4",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "mockjs": "1.1.0",
    "postcss": "8.5.29",
    "postcss-mobile-forever": "5.0.0",
    "rimraf": "6.1.3",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.105.1",
    "typescript": "6.0.3",
    "unocss": "66.10.5",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "7.3.7",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-mock": "2.9.8",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": ">=11.8.0"
  },
  "packageManager": "pnpm@11.8.0",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix --no-cache"
    ]
  }
}
