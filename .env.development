# must start with VITE_
VITE_ENV = 'development'

VITE_GLOB_APP_TITLE = 华新计量

# 只在开发模式中被载入
VITE_PORT = 8021

# 网站根目录（与老系统路由 base 一致：非 prod 为 /mestest）
VITE_PUBLIC_PATH = /mestest/

# 是否开启mock
VITE_USE_MOCK = false

# 是否hash路由
VITE_HASH_ROUTE = false

# 构建输出目录
VITE_OUTPUT_DIR = 'dist'

# ========== 应用运行模式 ==========
# standalone = 独立运行（使用自身登录流程）
# integrated = 作为子应用集成到 mbase（使用 mbase 登录）
VITE_APP_MODE = standalone

# 跨域代理，可以配置多个，请注意不要换行
VITE_PROXY = [["/api","http://localhost:9001"],["/upload","http://localhost:9001/upload"]]

# API 接口地址（开发环境通过 proxy 代理，此处留空）
VITE_GLOB_API_URL =

# 接口前缀（与 mock URL 保持一致）
VITE_GLOB_API_URL_PREFIX = /api

# 移动端应用 ID（用于获取菜单权限）
VITE_GLOB_APP_ID = wl-app-mes

# 图片上传地址
VITE_GLOB_UPLOAD_URL =

# 图片前缀地址
VITE_GLOB_IMG_URL_PREFIX =

# 地磅实时重量 WebSocket（校磅「取值」）
VITE_SCALE_WS_URL = ws://172.18.191.135:8080/ws/scale

